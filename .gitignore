# Dependencies
node_modules/
**/node_modules/

# Build output (content-hashed, generated by the CI build - never committed)
wp-content/themes/pgds/assets/dist/*
!wp-content/themes/pgds/assets/dist/.gitkeep

# Fetched font binaries (run `npm run fonts` to restore; see assets/fonts/README.md)
wp-content/themes/pgds/assets/fonts/*.woff2

# Local verification fixtures (generated by tools/seed-images.mjs and
# tools/expand-sample-data.mjs). Layout data only - never editorial content.
tools/seed-images/
tools/sample-data/data.expanded.json

# WordPress core & uploads (not part of the theme repo)
/wp-admin/
/wp-includes/
/wp-*.php
!/wp-config-sample.php
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/

# Secrets & env
.env
*.pem
*.key
wp-config.php
tools/sample-data/media-cache/

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local configuration and guidance — not part of the project
.claude/
CLAUDE.md

# Terraform local state and variable files (carry admin IPs / addresses / secrets)
infra/terraform/**/.terraform/
infra/terraform/**/terraform.tfvars
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/tfplan
